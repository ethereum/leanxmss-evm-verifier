module

public import LeanXmssEvmVerifierProofs.Code
public import LeanXmssEvmVerifierProofs.HarnessCode
public import EthLib.Execution.Proofs.Evm.Logic.Relocated

/-!
# The verifier as one block of code, at any offset

`PQProofOfPossession` and the harness hold the same verifier, at different offsets.

The bytes of the two copies differ only in the PUSH2 data of its jump targets.

Each is the position of the target in the verifier plus the offset of the verifier.

`proofs/scripts/generate-block.py` writes this file from the two codes, and CI fails if it differs.
-/

@[expose] public section

namespace LeanXmssEvmVerifierProofs

open EthLib.Execution.Evm.Logic

/-- The size of the verifier: 13720 bytes. -/
def BLOCK_SIZE : Nat := 13720

/-- The verifier as one number, the first byte highest, each target a position in it. -/
def BLOCK_NUMBER : Nat :=
  

/-- The verifier, with each jump target a position in it. -/
def BLOCK : ByteArray := NatCode.ofNat BLOCK_NUMBER 13720

/-- Bit `i` is set when byte `i` of the verifier is the same in every copy. -/
def BLOCK_FIXED : Nat :=
  

/-- Bit `i` is set when byte `i` is a PUSH2 of a jump target. -/
def BLOCK_RELOC : Nat :=
  

/-- Bit `i` is set when byte `i` is a JUMPDEST. -/
def BLOCK_DEST : Nat :=
  

/-- The code holds the verifier from `base`, its targets moved by `base`.

Each lemma about the verifier takes it as an instance, so a use finds it alone. -/
class VerifierCode (code : ByteArray) (base : Nat) : Prop where
  /-- The bytes of the code from `base`. -/
  relocated : Relocated code base BLOCK BLOCK_FIXED BLOCK_RELOC BLOCK_DEST

/-- `PQProofOfPossession` holds the verifier from byte 0x132. -/
instance verifierCode : VerifierCode CODE 0x132 :=
  ⟨relocated_ofNat (by decide +kernel)⟩

/-- The harness holds the verifier from byte 0x67. -/
instance harnessVerifierCode : VerifierCode HARNESS_CODE 0x67 :=
  ⟨relocated_ofNat (by decide +kernel)⟩

end LeanXmssEvmVerifierProofs
